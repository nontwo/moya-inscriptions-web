{
  "name": "@moya/tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project e2e/tsconfig.json",
    "test": "vitest run --exclude 'integration/postgres/**' --exclude 'e2e/**'",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:postgres": "vitest run integration/postgres"
  },
  "devDependencies": {
    "@moya/api": "workspace:*",
    "@moya/backend-production": "workspace:*",
    "@moya/backend-runtime": "workspace:*",
    "@moya/catalog-importer": "workspace:*",
    "@moya/catalog-postgres": "workspace:*",
    "@moya/contracts": "workspace:*",
    "@moya/design-tokens": "workspace:*",
    "@moya/image": "workspace:*",
    "@moya/public-api": "workspace:*",
    "@moya/ui": "workspace:*",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "exceljs": "4.4.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
