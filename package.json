{
  "name": "moya-inscriptions-web",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering foundation for the Moya inscriptions digital platform.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web --filter=admin",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @moya/catalog-postgres migrate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:postgres": "pnpm --filter @moya/tests test:postgres",
    "generate:catalog-import-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs",
    "check:catalog-import-template": "pnpm --filter @moya/contracts build && node scripts/generate-catalog-import-template.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "exceljs": "4.4.0",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "turbo": "2.10.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
