  "info": {
    "description": "Inscription-first, read-only access to the public Catalog. Operational health is unversioned; public Catalog contracts use /v1.",
    "title": "由艺（Yoyi）Public API",
    "version": "1.0.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/health": {
      "get": {
        "description": "Unversioned operational endpoint. Query parameters are not accepted.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is ready."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Operational readiness"
      }
    },
    "/v1/catalog": {
      "get": {
        "description": "Only kind, page, and pageSize are accepted. Unknown, duplicate, or invalid query parameters return INVALID_QUERY.",
        "operationId": "listCatalog",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "enum": ["inscription", "calligraphy"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "maxLength": 16,
              "pattern": "^[1-9]\\d*$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "maxLength": 16,
              "pattern": "^[1-9]\\d*$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            },
            "description": "A page of public Catalog entries."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "List public Catalog entries"
      }
    },
    "/v1/catalog/{catalogId}": {
      "get": {
        "description": "Catalog detail lookup accepts no query parameters.",
        "operationId": "getCatalogById",
        "parameters": [
          {
            "description": "Opaque platform CatalogId.",
            "in": "path",
            "name": "catalogId",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CatalogId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogDetail"
                }
              }
            },
            "description": "The requested public Catalog entry."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Catalog entry not found; error code ITEM_NOT_FOUND."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Get one public Catalog entry"
      }
    }
  }
}
