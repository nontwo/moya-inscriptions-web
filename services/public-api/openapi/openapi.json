{
  "components": {
    "schemas": {
      "ApiError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_QUERY",
                  "ITEM_NOT_FOUND",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "requestId": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ArchiveItemDetail": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "categoryIds": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "coordinates": {
            "additionalProperties": false,
            "properties": {
              "latitude": {
                "maximum": 90,
                "minimum": -90,
                "type": "number"
              },
              "longitude": {
                "maximum": 180,
                "minimum": -180,
                "type": "number"
              }
            },
            "required": ["latitude", "longitude"],
            "type": "object"
          },
          "coverImageKey": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?![a-z][a-z0-9+.-]*:)(?!\\/)\\S+$",
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "historicalPeriod": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "sortKey": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": ["label"],
            "type": "object"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "images": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "alt": {
                  "minLength": 1,
                  "type": "string"
                },
                "caption": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "objectKey": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?![a-z][a-z0-9+.-]*:)(?!\\/)\\S+$",
                  "type": "string"
                },
                "sortOrder": {
                  "maximum": 9007199254740991,
                  "minimum": 0,
                  "type": "integer"
                },
                "thumbnailObjectKey": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?![a-z][a-z0-9+.-]*:)(?!\\/)\\S+$",
                  "type": "string"
                }
              },
              "required": ["id", "objectKey", "alt", "sortOrder"],
              "type": "object"
            },
            "type": "array"
          },
          "location": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "minLength": 1,
                "type": "string"
              },
              "locality": {
                "minLength": 1,
                "type": "string"
              },
              "province": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["displayName"],
            "type": "object"
          },
          "references": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "citation": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "minLength": 1,
                  "type": "string"
                },
                "url": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": ["title"],
              "type": "object"
            },
            "type": "array"
          },
          "relatedItemIds": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "aliases",
          "categoryIds",
          "images",
          "references",
          "relatedItemIds"
        ],
        "type": "object"
      },
      "ArchiveItemId": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "ArchiveItemPage": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "aliases": {
                  "items": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "categoryIds": {
                  "items": {
                    "maxLength": 128,
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "coverImageKey": {
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^(?![a-z][a-z0-9+.-]*:)(?!\\/)\\S+$",
                  "type": "string"
                },
                "historicalPeriod": {
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "sortKey": {
                      "maximum": 9007199254740991,
                      "minimum": -9007199254740991,
                      "type": "integer"
                    }
                  },
                  "required": ["label"],
                  "type": "object"
                },
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^\\S+$",
                  "type": "string"
                },
                "location": {
                  "additionalProperties": false,
                  "properties": {
                    "displayName": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "locality": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "province": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": ["displayName"],
                  "type": "object"
                },
                "summary": {
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["id", "title", "aliases", "categoryIds"],
              "type": "object"
            },
            "type": "array"
          },
          "page": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["items", "total", "page", "pageSize", "totalPages"],
        "type": "object"
      },
      "ArchiveItemSummary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "categoryIds": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "coverImageKey": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?![a-z][a-z0-9+.-]*:)(?!\\/)\\S+$",
            "type": "string"
          },
          "historicalPeriod": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "sortKey": {
                "maximum": 9007199254740991,
                "minimum": -9007199254740991,
                "type": "integer"
              }
            },
            "required": ["label"],
            "type": "object"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "location": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "minLength": 1,
                "type": "string"
              },
              "locality": {
                "minLength": 1,
                "type": "string"
              },
              "province": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["displayName"],
            "type": "object"
          },
          "summary": {
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "title", "aliases", "categoryIds"],
        "type": "object"
      },
      "CategoryFacet": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "count": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "label", "count"],
        "type": "object"
      },
      "CategoryFacetList": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "items": {
          "additionalProperties": false,
          "properties": {
            "count": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "label": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": ["id", "label", "count"],
          "type": "object"
        },
        "type": "array"
      },
      "HealthResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Source-independent, read-only access to publicly visible archive items. Operational health is unversioned; public archive contracts use /v1.",
    "title": "摩崖碑刻数字平台 Public API",
    "version": "1.0.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is operational."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Operational health"
      }
    },
    "/v1/categories": {
      "get": {
        "operationId": "listCategoryFacets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryFacetList"
                }
              }
            },
            "description": "Public category facets."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "List public category facets"
      }
    },
    "/v1/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "in": "query",
            "name": "categoryId",
            "required": false,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "default": "title",
              "enum": ["title", "period"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sortOrder",
            "required": false,
            "schema": {
              "default": "asc",
              "enum": ["asc", "desc"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveItemPage"
                }
              }
            },
            "description": "A page of public archive items."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "List public archive items"
      }
    },
    "/v1/items/{id}": {
      "get": {
        "operationId": "getItemById",
        "parameters": [
          {
            "description": "Opaque platform ArchiveItemId.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ArchiveItemId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveItemDetail"
                }
              }
            },
            "description": "The requested public item."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Archive item not found; error code ITEM_NOT_FOUND."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Get one public archive item"
      }
    },
    "/v1/search": {
      "get": {
        "operationId": "searchItems",
        "parameters": [
          {
            "in": "query",
            "name": "keyword",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "categoryId",
            "required": false,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "period",
            "required": false,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "required": false,
            "schema": {
              "default": "relevance",
              "enum": ["relevance", "title", "period"],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sortOrder",
            "required": false,
            "schema": {
              "default": "asc",
              "enum": ["asc", "desc"],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveItemPage"
                }
              }
            },
            "description": "A page of matching public items."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Search public archive items"
      }
    }
  }
}
