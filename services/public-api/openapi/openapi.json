{
  "components": {
    "schemas": {
      "ApiError": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "error": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "enum": [
                  "INVALID_QUERY",
                  "ITEM_NOT_FOUND",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR"
                ],
                "type": "string"
              },
              "message": {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              "requestId": {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "type": "object"
          }
        },
        "required": ["error"],
        "type": "object"
      },
      "ArchiveItemDetail": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "description": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "periodLabel": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "protectionOrCollectionUnitLabel": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "provinceLabel": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "sources": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "citation": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                "label": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                "url": {
                  "format": "uri",
                  "type": "string"
                }
              },
              "required": ["label"],
              "type": "object"
            },
            "type": "array"
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "title", "aliases", "sources"],
        "type": "object"
      },
      "ArchiveItemId": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^\\S+$",
        "type": "string"
      },
      "ArchiveItemPage": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "aliases": {
                  "items": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "id": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^\\S+$",
                  "type": "string"
                },
                "periodLabel": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "protectionOrCollectionUnitLabel": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                },
                "provinceLabel": {
                  "maxLength": 200,
                  "minLength": 1,
                  "type": "string"
                },
                "summary": {
                  "maxLength": 2000,
                  "minLength": 1,
                  "type": "string"
                },
                "title": {
                  "maxLength": 500,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": ["id", "title", "aliases"],
              "type": "object"
            },
            "type": "array"
          },
          "page": {
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer"
          },
          "pageSize": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "total": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": ["items", "total", "page", "pageSize", "totalPages"],
        "type": "object"
      },
      "ArchiveItemSummary": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "aliases": {
            "items": {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^\\S+$",
            "type": "string"
          },
          "periodLabel": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "protectionOrCollectionUnitLabel": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "provinceLabel": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "summary": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": ["id", "title", "aliases"],
        "type": "object"
      },
      "HealthResponse": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "PublicSourceCitation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "citation": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "label": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "format": "uri",
            "type": "string"
          }
        },
        "required": ["label"],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Inscription-first, read-only access to public archive items. Operational health is unversioned; public archive contracts use /v1.",
    "title": "摩崖碑刻数字平台 Public API",
    "version": "1.0.0"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service is ready."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Operational readiness"
      }
    },
    "/v1/items": {
      "get": {
        "operationId": "listItems",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveItemPage"
                }
              }
            },
            "description": "A page of public archive items."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Invalid query; error code INVALID_QUERY."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "List public archive items"
      }
    },
    "/v1/items/{id}": {
      "get": {
        "operationId": "getItemById",
        "parameters": [
          {
            "description": "Opaque platform ArchiveItemId.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ArchiveItemId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArchiveItemDetail"
                }
              }
            },
            "description": "The requested public item."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Archive item not found; error code ITEM_NOT_FOUND."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Internal service error; error code INTERNAL_ERROR."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service is temporarily unavailable; error code SERVICE_UNAVAILABLE."
          }
        },
        "summary": "Get one public archive item"
      }
    }
  }
}
