{
  "name": "@moya/backend-production",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./internal/cos-https": {
      "types": "./src/storage/cos-https.ts",
      "import": "./dist/storage/cos-https.js"
    },
    "./internal/cos-signature": {
      "types": "./src/storage/cos-signature.ts",
      "import": "./dist/storage/cos-signature.js"
    },
    "./internal/pilot-cos": {
      "types": "./src/storage/pilot-cos.ts",
      "import": "./dist/storage/pilot-cos.js"
    },
    "./internal/production-cos": {
      "types": "./src/storage/production-cos.ts",
      "import": "./dist/storage/production-cos.js"
    },
    "./internal/cos-read": {
      "types": "./src/storage/cos-read.ts",
      "import": "./dist/storage/cos-read.js"
    },
    "./internal/cos-sdk": {
      "types": "./src/storage/cos-sdk.ts",
      "import": "./dist/storage/cos-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "pilot": "node dist/pilot-cli.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@moya/catalog-importer": "workspace:*",
    "@moya/backend-runtime": "workspace:*",
    "@moya/catalog-postgres": "workspace:*",
    "@moya/image": "workspace:*",
    "cos-nodejs-sdk-v5": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.22.4"
  }
}
