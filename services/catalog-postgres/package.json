{
  "name": "@moya/catalog-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "migrate": "node dist/migrations/cli.js ../../database/migrations",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@moya/api": "workspace:*",
    "@moya/contracts": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0"
  }
}
