# Staging uses the same three-process/runtime contract as production.
# Create three private EnvironmentFiles from infra/production/env/*.env.example.
# Replace their service-specific values with isolated staging resources, then use
# these environment labels/origins. Do not share a staging DB/bucket with production.
NODE_ENV=production
MOYA_CONTENT_SOURCE=payload
CMS_ENVIRONMENT=staging
CMS_PUBLIC_URL=https://staging.example.invalid
CMS_PREVIEW_WEB_URL=https://staging.example.invalid
PUBLIC_MEDIA_BASE_URL=https://staging.example.invalid
# The service templates are authoritative for Web API base URL, DATABASE_URL,
# CMS_DATABASE_URL, CMS_SECRET, CMS_STORAGE_MODE=cos, COS runtime, pool and TLS.
# This overlay is documentation, not a fourth service EnvironmentFile.
