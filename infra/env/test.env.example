# Copy to a private file. Use a NEW synthetic loopback database, not yoyi_dev/Stage A.
NODE_ENV=test
HOST=127.0.0.1
PORT=3001
MOYA_PUBLIC_API_BASE_URL=http://127.0.0.1:3001
CMS_INTERNAL_URL=http://127.0.0.1:3002
MOYA_CONTENT_SOURCE=payload
# The legacy PostgreSQL suite and CMS suite require DISTINCT synthetic databases.
TEST_DATABASE_URL=postgresql://synthetic_test_role:REPLACE_ME@127.0.0.1:54329/moya_synthetic_test
CMS_TEST_DATABASE_URL=postgresql://synthetic_cms_test_role:REPLACE_ME@127.0.0.1:54329/p204_cms_synthetic_test
DATABASE_URL=postgresql://synthetic_test_role:REPLACE_ME@127.0.0.1:54329/moya_synthetic_test
CMS_DATABASE_URL=postgresql://synthetic_cms_test_role:REPLACE_ME@127.0.0.1:54329/p204_cms_synthetic_test
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_SSL_CA_FILE=
# CMS_DATABASE_SSL_CA_FILE=
CMS_SECRET=REPLACE_WITH_SYNTHETIC_TEST_SECRET
CMS_ENVIRONMENT=synthetic
CMS_PUBLIC_URL=http://127.0.0.1:3002
CMS_PREVIEW_WEB_URL=http://127.0.0.1:3000
CMS_STORAGE_MODE=local
CMS_MEDIA_DIR=../../.local/test-media
PUBLIC_MEDIA_BASE_URL=http://127.0.0.1:3002
# Local synthetic tests never require COS runtime credentials.
