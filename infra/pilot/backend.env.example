# Server-only /etc/moya-pilot/backend.env; root-owned 0600, outside the release.
# Fill from approved secure configuration. Empty DB deliberately fails startup.
DATABASE_URL=
MOYA_PILOT_SCOPE_FILE=
MOYA_PILOT_MEDIA_FILE=
COS_SECRET_ID=
COS_SECRET_KEY=
# Optional temporary credentials require BOTH fields (expiry is Unix seconds).
# COS_SECURITY_TOKEN=
# COS_CREDENTIAL_EXPIRES_AT=
# Upload/migration credentials must not be granted to the read-only API role.
# NODE_ENV/HOST/PORT are pinned by the systemd command, not configurable here.
