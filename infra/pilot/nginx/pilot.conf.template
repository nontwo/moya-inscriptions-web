# Include inside the existing nginx http {} context after target approval.
# Replace __PILOT_HOSTNAME__ with the approved DNS name, not a URL.
# Certificate/key and password files are server-side files, never repository files.
log_format moya_pilot '$time_iso8601 $status $request_time';

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __PILOT_HOSTNAME__;
    ssl_certificate /etc/moya-pilot/tls/fullchain.pem;
    ssl_certificate_key /etc/moya-pilot/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    auth_basic "Moya Pilot";
    auth_basic_user_file /etc/moya-pilot/htpasswd;
    access_log /var/log/nginx/moya-pilot-access.log moya_pilot;
    error_log /var/log/nginx/moya-pilot-error.log warn;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "private, no-store" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Access credentials terminate here, not in Web or the backend.
        proxy_set_header Authorization "";
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        proxy_cache off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
