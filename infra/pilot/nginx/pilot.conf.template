# Include in nginx http {}. Render only the five __PILOT_*__ placeholders.
# Paths must be absolute server-controlled paths without nginx metacharacters.
# No credentials, certificate contents or application data belong in this file.
log_format moya_pilot '$time_iso8601 $status $request_time';

map $http_host $moya_pilot_https_host {
    default 0;
    __PILOT_IPV4__ 1;
    __PILOT_IPV4__:443 1;
}

map $http_host $moya_pilot_http_host {
    default 0;
    __PILOT_IPV4__ 1;
    __PILOT_IPV4__:80 1;
}

map $request_method $moya_pilot_read_method {
    default 0;
    GET 1;
    HEAD 1;
}

map $status $moya_pilot_allow_header {
    default "";
    405 "GET, HEAD";
}

# $uri has already decoded one percent-encoding layer, resolved dot segments
# and merged slashes. These ASCII patterns reject residual encoding/backslashes.
# Only the existing Formal routes and their assets can reach Next.js.
map $uri $moya_pilot_allowed_uri {
    default 0;
    / 1;
    /api/catalog 1;
    /_pilot/status 1;
    "~^/(api/)?catalog/catalog-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" 1;
    ~^/_next/static/[A-Za-z0-9_./~-]+$ 1;
    /packages/design-tokens/src/theme.css 1;
    /packages/ui/src/styles.css 1;
    ~^/packages/ui/src/assets/(icons|textures|brand|labels)/[a-z0-9-]+\.(svg|png)$ 1;
}

server {
    listen 80 default_server;
    server_name __PILOT_IPV4__;
    server_tokens off;
    merge_slashes on;
    access_log /var/log/nginx/moya-pilot-access.log moya_pilot;
    error_log /dev/null;
    add_header Cache-Control "private, no-store" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Allow $moya_pilot_allow_header always;

    if ($moya_pilot_http_host = 0) { return 421; }
    if ($moya_pilot_read_method = 0) { return 405; }

    # Dedicated ACME webroot contains only public challenge material.
    # HTTP never proxies the application and never solicits Basic credentials.
    location ~ ^/\.well-known/acme-challenge/[A-Za-z0-9_-]+$ {
        auth_basic off;
        root __PILOT_ACME_ROOT__;
        default_type text/plain;
        autoindex off;
        disable_symlinks on;
        try_files $uri =404;
    }
    location / { return 404; }
}

server {
    listen 443 ssl default_server;
    server_name __PILOT_IPV4__;
    ssl_certificate __PILOT_TLS_DIR__/fullchain.pem;
    ssl_certificate_key __PILOT_TLS_DIR__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    merge_slashes on;

    auth_basic "Moya Pilot";
    auth_basic_user_file __PILOT_AUTH_FILE__;
    access_log /var/log/nginx/moya-pilot-access.log moya_pilot;
    # Error logs may include request URIs; do not persist them in this Pilot.
    error_log /dev/null;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "private, no-store" always;
    add_header Allow $moya_pilot_allow_header always;

    if ($moya_pilot_https_host = 0) { return 421; }
    if ($moya_pilot_read_method = 0) { return 405; }
    if ($moya_pilot_allowed_uri = 0) { return 404; }

    # Operational certificate status, generated by the certificate helper.
    # This location inherits authentication and every response header above.
    location = /_pilot/status {
        root __PILOT_STATUS_ROOT__;
        default_type text/html;
        autoindex off;
        disable_symlinks on;
        try_files /index.html =503;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host __PILOT_IPV4__;
        proxy_set_header X-Forwarded-Host __PILOT_IPV4__;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Owner Basic credentials end here, before Web, backend or COS.
        proxy_set_header Authorization "";
        proxy_set_header Proxy-Authorization "";
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        proxy_cache off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
