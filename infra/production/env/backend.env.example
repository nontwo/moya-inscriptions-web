# Private copy: /etc/yoyi/backend.env (root-owned, 0600); all provider values fictional.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
MOYA_CONTENT_SOURCE=payload
DATABASE_URL=postgresql://REPLACE_ME_PUBLIC_READ_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
DATABASE_POOL_MAX=5
DATABASE_IDLE_TIMEOUT_MS=10000
# Community V1 App role: DML-only on the community schema, distinct from the public read and CMS roles.
# Community migrations run separately with a migration-privileged role (APP_MIGRATION_DATABASE_URL), never at startup.
APP_DATABASE_URL=postgresql://REPLACE_ME_APP_ROLE:REPLACE_ME_PASSWORD@database.example.invalid:5432/REPLACE_ME_DATABASE?sslmode=verify-full
# Owner moderation boundary: 32-512 characters, shared only with admin.env and
# rotated together. Leaving it unset keeps the loopback-only /internal/community/*
# subpath closed, so a missing value fails safe.
COMMUNITY_OPERATOR_TOKEN=REPLACE_ME_COMMUNITY_OPERATOR_TOKEN
# Optional custom CA; when omitted TLS uses system CAs. Never disable CA validation.
# DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
# APP_DATABASE_SSL_CA_FILE=/etc/yoyi/ca/database-ca.pem
CMS_STORAGE_MODE=cos
COS_BUCKET=REPLACE_ME_PRIVATE_BUCKET
COS_REGION=REPLACE_ME_REGION
# Verified custom HTTPS media domain; bind and validate at Stage B.
COS_MEDIA_ORIGIN=https://media.example.invalid
COS_SECRET_ID=REPLACE_ME_BACKEND_READ_SECRET_ID
COS_SECRET_KEY=REPLACE_ME_BACKEND_READ_SECRET_KEY
# Optional short-lived credentials are configured together when used.
# COS_SECURITY_TOKEN=REPLACE_ME_SESSION_TOKEN
# COS_CREDENTIAL_EXPIRES_AT=REPLACE_ME_EXPIRY
COS_SIGNED_URL_TTL_SECONDS=300
COS_REQUEST_TIMEOUT_MS=5000
